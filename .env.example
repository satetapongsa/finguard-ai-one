# Groq API key จาก https://console.groq.com/keys (ห้าม commit ไฟล์ .env.local)
GROQ_API_KEY=
# โมเดลที่ใช้ (ไม่ใส่ก็ได้ ใช้ค่า default ใน lib/groq.js)
GROQ_MODEL=openai/gpt-oss-120b
# Neon Postgres สำหรับงานประจำวัน (ไม่ใส่ก็ได้ตอนรันในเครื่อง จะเก็บที่ .data/state.json)
DATABASE_URL=
# Vercel ส่งค่านี้มากับ cron เพื่อกันคนอื่นเรียก /api/cron
CRON_SECRET=
# ล็อกอิน: สุ่มข้อความยาว ๆ สำหรับ AUTH_SECRET และตั้งรหัสผ่านของหัวหน้า / พนักงาน
AUTH_SECRET=
MANAGER_PASSWORD=
STAFF_PASSWORD=
# อีเมลสรุปทุกเช้า (ไม่ใส่ = ไม่ส่ง): key จาก https://resend.com, อีเมลผู้รับ (คั่นด้วย ,), ลิงก์เว็บในอีเมล
RESEND_API_KEY=
NOTIFY_EMAIL=
APP_URL=https://finguard-ai-one.vercel.app
